# OkHttp / okio reference some optional classes (Conscrypt, BouncyCastle, etc.)
# that aren't on the classpath -- suppress warnings for those, they're fine to miss.
-dontwarn okhttp3.**
-dontwarn okio.**

# org.json is used directly for all Deck API parsing -- keep it intact.
-keep class org.json.** { *; }

# Room -- keep entities and the generated database/DAO implementations so column mapping
# and generated bytecode aren't affected by shrinking/renaming.
-keep class com.brbrs.tavla.data.** { *; }
-keep class * extends androidx.room.RoomDatabase
-keep @androidx.room.Entity class *

# Hilt -- keep generated components and annotated entry points.
-keep class dagger.hilt.** { *; }
-keep class * extends dagger.hilt.android.internal.managers.ViewComponentManager
-keepclasseswithmembers class * {
    @dagger.hilt.android.AndroidEntryPoint <methods>;
}
-keepattributes *Annotation*

# Coroutines -- keep names (not full bodies) so stack traces and debug metadata stay readable.
-keepnames class kotlinx.coroutines.internal.MainDispatcherFactory
-keepnames class kotlinx.coroutines.CoroutineExceptionHandler
-dontwarn kotlinx.coroutines.debug.**

# Google Tink (pulled in by androidx.security.crypto, used for the Solidtime token store) --
# its annotation-only dependencies (error-prone, JSR 305, checker-qual) aren't on the
# compile/runtime classpath and aren't needed at runtime; just silence R8's missing-class check.
-dontwarn com.google.errorprone.annotations.**
-dontwarn javax.annotation.**
-dontwarn org.checkerframework.**
-dontwarn com.google.j2objc.annotations.**
-dontwarn org.joda.convert.**

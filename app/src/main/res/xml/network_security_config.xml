<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Plain HTTP is allowed for private-network / Tailscale setups. Bare addresses
         still default to https:// in the login screen; only an explicit http:// is kept. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
